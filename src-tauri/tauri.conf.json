{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Accounts",
  "version": "0.1.0",
  "identifier": "com.local.codexaccounts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Accounts",
        "width": 1100,
        "height": 700,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Локальный менеджер аккаунтов Codex",
    "longDescription": "Панель управления локальными аккаунтами Codex с просмотром лимитов, ручным переключением и резервным копированием.",
    "category": "DeveloperTool"
  }
}
