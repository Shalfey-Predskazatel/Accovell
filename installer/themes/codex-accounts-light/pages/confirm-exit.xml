<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,68" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true" textrenderinghint="3">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" bold="true" name="Segoe UI Semibold" size="29" />
  <Font id="2" bold="true" name="Segoe UI Semibold" size="14" />
  <Container name="page-root">
    <LightBackdrop float="0,0,1,1" canvascolor="{{color.canvas}}" bluecolor="{{color.blueTint}}" pinkcolor="{{color.pinkTint}}" />
    <VerticalLayout float="0,0,1,1">
      <HorizontalLayout height="72" inset="30,17,24,17" childvalign="vcenter">
        <BrandMark animated="true" outercolor="{{color.markOuter}}" outlinecolor="{{color.markOutline}}" raycolor="{{color.markRays}}" width="38" height="38" brandcolor="{{color.brand}}" />
        <Label text="Codex Accounts Setup" font="2" textcolor="{{color.textPrimary}}" padding="12,0,0,0" />
        <Control />
      </HorizontalLayout>
      <VerticalLayout inset="150,84,150,58">
        <Control />
        <Label text="{{string.confirmExit.title}}" font="1" textcolor="{{color.textPrimary}}" height="56" align="center" />
        <Label text="{{string.confirmExit.description}}" textcolor="{{color.textSecondary}}" height="75" align="center" endellipsis="true" />
        <Control height="24" />
        <HorizontalLayout height="52">
          <Control />
          <SoftButton ripplecolor="{{color.brandEnd}}" name="exit-stay" text="{{string.confirmExit.stay}}" textcolor="{{color.textPrimary}}" bkcolor="{{color.surfaceMuted}}" hotbkcolor="{{color.surfaceStrong}}" pushedbkcolor="{{color.surfaceStrong}}" width="190" height="50" borderround="13,13" font="2" />
          <Control width="12" />
          <SoftButton ripplecolor="{{color.brandEnd}}" name="exit-confirm" text="{{string.confirmExit.confirm}}" textcolor="{{color.ink}}" bkcolor="{{color.brand}}" hotbkcolor="{{color.brandHover}}" pushedbkcolor="{{color.brandPressed}}" width="156" height="50" borderround="13,13" font="2" />
          <Control />
        </HorizontalLayout>
        <Control />
      </VerticalLayout>
    </VerticalLayout>
  </Container>
</Window>

