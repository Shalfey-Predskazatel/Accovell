{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x86",
      "displayName": "Windows x86 (MSVC)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/windows-x86-ninja"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86",
      "configuration": "Debug"
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
